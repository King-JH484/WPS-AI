<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="wpsAiTab" label="灵犀AI" 	insertBeforeMso="TabHome">
        <group id="lingxiCore" label="灵犀AI">
          <button id="openWpsAiPane" label="打开灵犀AI" size="large" image="images/ai.png" onAction="OnAction_openWpsAiPane" getImage="GetImage_openWpsAiPane" getVisible="OnGetVisible" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_writing" label="写作">
          <button id="quick.wps.helpWrite" label="帮我写" size="normal" image="images/icons/writing.png" onAction="OnAction_quick_wps_helpWrite" getImage="GetImage_quick_wps_helpWrite" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.continue" label="续写" size="normal" image="images/icons/writing.png" onAction="OnAction_quick_wps_continue" getImage="GetImage_quick_wps_continue" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.expand" label="扩写" size="normal" image="images/icons/writing.png" onAction="OnAction_quick_wps_expand" getImage="GetImage_quick_wps_expand" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.shrink" label="缩写" size="normal" image="images/icons/writing.png" onAction="OnAction_quick_wps_shrink" getImage="GetImage_quick_wps_shrink" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.rewrite" label="重写" size="normal" image="images/icons/writing.png" onAction="OnAction_quick_wps_rewrite" getImage="GetImage_quick_wps_rewrite" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_polish" label="润色">
          <button id="quick.wps.polish" label="快速润色" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polish" getImage="GetImage_quick_wps_polish" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.optimize" label="优化" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_optimize" getImage="GetImage_quick_wps_optimize" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishFormal" label="更正式" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polishFormal" getImage="GetImage_quick_wps_polishFormal" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishAcademic" label="更学术" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polishAcademic" getImage="GetImage_quick_wps_polishAcademic" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishGov" label="党政风" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polishGov" getImage="GetImage_quick_wps_polishGov" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishLively" label="更活泼" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polishLively" getImage="GetImage_quick_wps_polishLively" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishCasual" label="口语化" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polishCasual" getImage="GetImage_quick_wps_polishCasual" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishAll" label="全文润色" size="normal" image="images/icons/polish.png" onAction="OnAction_quick_wps_polishAll" getImage="GetImage_quick_wps_polishAll" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_translate" label="翻译">
          <button id="quick.wps.translate" label="翻译选中" size="normal" image="images/icons/translate.png" onAction="OnAction_quick_wps_translate" getImage="GetImage_quick_wps_translate" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_document" label="文档">
          <button id="quick.wps.summary" label="全文总结" size="normal" image="images/icons/document.png" onAction="OnAction_quick_wps_summary" getImage="GetImage_quick_wps_summary" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.mindmap" label="文档脑图" size="normal" image="images/icons/document.png" onAction="OnAction_quick_wps_mindmap" getImage="GetImage_quick_wps_mindmap" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.format" label="AI 排版" size="normal" image="images/icons/document.png" onAction="OnAction_quick_wps_format" getImage="GetImage_quick_wps_format" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.qa" label="文档问答" size="normal" image="images/icons/document.png" onAction="OnAction_quick_wps_qa" getImage="GetImage_quick_wps_qa" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_image" label="图像">
          <button id="quick.wps.image" label="AI 生成图片" size="normal" image="images/icons/image.png" onAction="OnAction_quick_wps_image" getImage="GetImage_quick_wps_image" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.materialLibrary" label="素材库" size="normal" image="images/icons/image.png" onAction="OnAction_quick_wps_materialLibrary" getImage="GetImage_quick_wps_materialLibrary" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_smart" label="智能">
          <button id="quick.wps.suggest" label="智能推荐操作" size="normal" image="images/icons/wand.png" onAction="OnAction_quick_wps_suggest" getImage="GetImage_quick_wps_suggest" getEnabled="OnGetEnabled"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
