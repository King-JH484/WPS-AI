<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="wpsAiTab" label="灵犀AI" 	insertBeforeMso="TabHome">
        <group id="lingxiCore" label="灵犀AI">
          <button id="openWpsAiPane" label="打开灵犀AI" size="large" onAction="OnAction" getImage="GetImage" getVisible="OnGetVisible" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_writing" label="写作">
          <button id="quick.wps.helpWrite" label="帮我写" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.continue" label="续写" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.expand" label="扩写" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.shrink" label="缩写" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.rewrite" label="重写" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_polish" label="润色">
          <button id="quick.wps.polish" label="快速润色" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.optimize" label="优化" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishFormal" label="更正式" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishAcademic" label="更学术" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishGov" label="党政风" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishLively" label="更活泼" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishCasual" label="口语化" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.polishAll" label="全文润色" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_translate" label="翻译">
          <button id="quick.wps.translate" label="翻译" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_document" label="文档">
          <button id="quick.wps.summary" label="全文总结" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.mindmap" label="文档脑图" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.format" label="AI 排版" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.qa" label="文档问答" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_image" label="图像">
          <button id="quick.wps.image" label="AI 生成图片" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
          <button id="quick.wps.materialLibrary" label="素材库" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
        </group>
        <group id="lingxi_wps_smart" label="智能">
          <button id="quick.wps.suggest" label="智能推荐操作" size="normal" onAction="OnAction" getImage="GetImage" getEnabled="OnGetEnabled"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
