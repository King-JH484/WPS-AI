# cmd.exe 要求 .bat 文件 CRLF 行尾，否则解析会出错
# 默认 .bat 走 GBK（中文 Windows 默认代码页）
*.bat        text eol=crlf working-tree-encoding=GBK
# post-install-windows.bat 自己 chcp 65001 切 UTF-8,文件本身就是 UTF-8 存
plugin/tools/post-install-windows.bat text eol=crlf

# .sh 必须 LF
*.sh         text eol=lf

# 其它文本默认按 git 自动处理
*.js         text
*.json       text
*.html       text
*.css        text
*.md         text
*.xml        text
*.svg        text

# 图片二进制
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
