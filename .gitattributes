# cmd.exe 要求 .bat 文件 CRLF 行尾，否则解析会出错
*.bat        text eol=crlf working-tree-encoding=GBK

# .sh 必须 LF
*.sh         text eol=lf

# 其它文本默认按 git 自动处理
*.js         text
*.json       text
*.html       text
*.css        text
*.md         text
*.xml        text
*.svg        text

# 图片二进制
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
